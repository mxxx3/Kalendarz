rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(workspaceId) {
      return signedIn() &&
        request.auth.uid in get(
          /databases/$(database)/documents/workspaces/$(workspaceId)
        ).data.memberUids;
    }

    function allowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields)
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /workspaces/{workspaceId} {
      // A logged-in owner creates the workspace with ONLY themselves as a member.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','ownerId','memberUids','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // Workspace identity is private; a membership/UID invitation is required.
      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow list: if false;

      // Only owner can invite or revoke members. Owner cannot transfer ownership.
      allow update: if signedIn() && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','memberUids'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 20
        && request.auth.uid in request.resource.data.memberUids;
      allow delete: if false;

      match /jobs/{jobId} {
        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId)
          && allowedFields(['title','start','end','cents','status','clientId',
            'address','notes','deleted','updatedBy','updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.start is string
          && request.resource.data.end is string
          && request.resource.data.start <= request.resource.data.end
          && request.resource.data.cents is int
          && request.resource.data.cents >= 0
          && request.resource.data.status in ['PLANNED','IN_PROGRESS','DONE','CANCELLED']
          && request.resource.data.deleted is bool
          && request.resource.data.address is string
          && request.resource.data.notes is string
          && request.resource.data.updatedAt is timestamp
          && (request.resource.data.clientId == null || request.resource.data.clientId is string);
        allow delete: if false;
      }

      match /clients/{clientId} {
        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId)
          && allowedFields(['name','phone','address','notes','archived','updatedBy','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.phone is string
          && request.resource.data.address is string
          && request.resource.data.notes is string
          && request.resource.data.archived is bool
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId)
          && allowedFields(['jobId','cents','paidAt','method','notes','updatedBy','updatedAt'])
          && request.resource.data.jobId is string
          && request.resource.data.jobId.size() > 0
          && request.resource.data.cents is int
          && request.resource.data.cents > 0
          && request.resource.data.paidAt is string
          && request.resource.data.method is string
          && request.resource.data.notes is string
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isMember(workspaceId);
      }
    }
    // No public data and no other collection access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
